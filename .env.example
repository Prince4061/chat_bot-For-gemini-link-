# =============================================================================
#  AI Digital Vending Deep Agent - environment configuration
#  Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | production  (production enforces ADMIN_API_KEY, CORS_ORIGINS, SECRET_KEY)
APP_ENV=development
HOST=0.0.0.0
PORT=5000
# Random string used for Flask session signing. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# --- Security ----------------------------------------------------------------
# OPTIONAL. Leave EMPTY to keep the admin dashboard open (no login required).
# If you set a value, the dashboard and every /api/admin/* call must present it
# as `X-Admin-Token: <key>`. Recommended if the server is reachable from the internet.
ADMIN_API_KEY=
# Comma-separated browser origins allowed to call the API (use your real domain in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5000
# Optional shared secret for the WhatsApp webhook: append ?token=<secret> to the webhook URL in Evolution.
EVOLUTION_WEBHOOK_SECRET=
# Set to true when running behind nginx / a load balancer so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false

# --- Database ----------------------------------------------------------------
# Default is a local SQLite file (fine for a single server). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/vending
DATABASE_URL=

# --- OpenAI / Deep Agent -----------------------------------------------------
# Can also be set from the admin dashboard (dashboard value wins). Without a key the
# bot runs on the deterministic rule-based engine.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
AGENT_RECURSION_LIMIT=30
CHAT_HISTORY_WINDOW=20

# --- WhatsApp (Evolution API) ------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=VendingBot
WEBHOOK_WORKERS=4

# --- Payments / business rules -----------------------------------------------
ADMIN_UPI_ID=resellerpay@upi
ADMIN_UPI_NAME=Digital Vending Admin
RESELLER_CREDIT_RATE_INR=150
MAX_CLAIM_QUANTITY=10
RESELLER_MAX_FAILED_ATTEMPTS=5
RESELLER_LOCKOUT_MINUTES=15

# --- Rate limits (requests per minute per IP) --------------------------------
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_ADMIN_LOGIN_PER_MIN=10
RATE_LIMIT_WEBHOOK_PER_MIN=120

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# Optional rotating log file, e.g. logs/app.log
LOG_FILE=
